  "narrative": {
    "northStar": "The Playable Storybook",
    "overview": "Rounded original 3D figurines inhabit magical pastel landscapes. Blinking eyes, flowing tapered hair, pearlescent fairy wings and a scalloped dress give the characters their storybook detail. Patterned butterflies, wind-bent grass, drifting clouds and rippling lily ponds animate the planted scenery around textured paths and recognizable landmarks. The interface uses warm paper, sturdy rounded lettering and generous controls to keep that world readable.\n\nThe world remains animated behind the title and celebrations. Paper menus provide a quieter place to choose worlds and revisit friends. Preserve Mia's blonde hair, blue dress and wings; Glender's yellow mane, yellow tail and body stars; and white unicorn bodies with distinct mane colors. Exact provisional appearance choices remain in `DESIGN_NOTES.md`.",
    "keyCharacteristics": [
      "Expressive dimensional characters, patterned butterflies and living planted scenery, with original artwork.",
      "Warm paper, blue actions, navy ink and pink/gold accents.",
      "Large icon-led controls and short, friendly labels.",
      "Galloping, hinged wing flutter, water magic, fading rainbow boosts and shared celebrations."
    ],
    "rules": [
      {
        "name": "The World Palette Rule",
        "body": "Keep the interface palette stable across worlds; distinguish worlds through scenery, landmarks and the configured environment colors.",
        "section": "colors"
      },
      {
        "name": "The Short Label Rule",
        "body": "Pair actions with the original SVG icons and concise words; reserve reading for menus and brief encouragement.",
        "section": "typography"
      },
      {
        "name": "The Clear World Rule",
        "body": "Keep the chase corridor and character silhouettes unobstructed by menus, encouragement and touch controls.",
        "section": "layout"
      },
      {
        "name": "The Soft Lift Rule",
        "body": "Raised interface surfaces use blurred, tinted shadows; do not restore the removed hard offset primary-button shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve confirmed character colors, powers and recognizable silhouettes.",
      "**Do** reuse the paper/blue/ink hierarchy while each world contributes its own scenery.",
      "**Do** retain large touch targets, visible keyboard focus and safe-area clearance.",
      "**Do** keep portraits and celebrations unobstructed, with all eleven friends visible in the finale.",
      "**Do** keep provisional names, coat choices and tuning editable through configuration and documented in `DESIGN_NOTES.md`."
    ],
    "donts": [
      "**Don't** add an eyebrow above the title or restore the removed hard offset primary shadow.",
      "**Don't** replace original icons or dimensional artwork with glyph icons or placeholder figures.",
      "**Don't** add text-heavy instructions or developer controls to the play surface.",
      "**Don't** treat browser viewport captures as physical iPad performance or touch validation."
    ]
  }
}
